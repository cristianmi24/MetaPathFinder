# =============================================
# MetaPathFinder - Variables de Entorno (Railway)
# =============================================
# Copia este archivo como referencia y completa
# tus valores en Railway Dashboard.
# =============================================

# --- Base de datos (PostgreSQL Neon) ---
# URL asíncrona (para SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://usuario:password@ep-tu-host.us-east-1.aws.neon.tech/tu-db?ssl=require

# URL síncrona (para SQLAlchemy, migraciones, etc.)
DATABASE_URL_SYNC=postgresql://usuario:password@ep-tu-host.us-east-1.aws.neon.tech/tu-db?sslmode=require

# --- Seguridad ---
SECRET_KEY=pon-aqui-una-clave-secreta-segura

# --- Entorno ---
ENVIRONMENT=production

# --- CORS (orígenes permitidos) ---
# Pon la URL de tu app en Railway, separada por comas
CORS_ORIGINS=https://tudominio.railway.app

# --- Capacidad (50 estudiantes simultáneos) ---
WEB_CONCURRENCY=3
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=12
API_RATE_LIMIT_PER_MINUTE=400
API_ANON_RATE_LIMIT_PER_MINUTE=300

# --- Sistema tutor ---
# Grupo por defecto para estudiantes sin asignación experimental: experimental | control
TUTOR_DEFAULT_GROUP=experimental
